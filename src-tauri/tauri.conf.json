{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skills Manager",
  "version": "0.1.0",
  "identifier": "dev.skillsmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1423",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Skills Manager",
      "width": 1180,
      "height": 760,
      "minWidth": 680,
      "minHeight": 520,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "One canonical Skills library for local coding agents",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
